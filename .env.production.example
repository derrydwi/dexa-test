# Copy to .env.production and replace every placeholder before deployment.
# Generate independent database secrets with: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=replace_with_a_unique_root_password
IDENTITY_DB_PASSWORD=replace_with_a_64_character_hex_password
ATTENDANCE_DB_PASSWORD=replace_with_another_64_character_hex_password
INITIAL_ACCOUNT_PASSWORD=replace_with_a_unique_initial_account_password
APP_ORIGIN=https://attendance.example.com
# Use an absolute host path when the deployment platform stores Compose elsewhere.
MYSQL_INIT_SCRIPT=./infra/init.production.sh
