# Copy to .env for native Node development. Docker Compose supplies its own hostnames.
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
IDENTITY_PORT=3001
ATTENDANCE_PORT=3002
IDENTITY_URL=http://localhost:3001
IDENTITY_DATABASE_URL=mysql://identity:identity_local@127.0.0.1:3307/identity_db
ATTENDANCE_DATABASE_URL=mysql://attendance:attendance_local@127.0.0.1:3307/attendance_db
UPLOAD_DIR=./uploads
DEMO_PASSWORD=DemoPass123!
